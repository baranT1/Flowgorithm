<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="&#220;&#231;gen Olu&#351;turma &#214;devi"/>
        <attribute name="authors" value="baran"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-13 12:55:08 &#214;&#214;"/>
        <attribute name="created" value="YmFyYW47RVpHSTsyMDI2LTEwLTEzOzEyOjA1OjU2IMOWw5Y7MjM2OA=="/>
        <attribute name="edited" value="YmFyYW47RVpHSTsyMDI2LTEwLTEzOzEyOjU1OjA4IMOWw5Y7MTsyNDc4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="ac&#305;1, ac&#305;2, ac&#305;3, ac&#305;toplam" type="Real" array="False" size=""/>
            <output expression="&quot;1. A&#231;&#305; De&#287;erini Giriniz: &quot;" newline="True"/>
            <input variable="ac&#305;1"/>
            <output expression="&quot;2. A&#231;&#305; De&#287;erini Giriniz: &quot;" newline="True"/>
            <input variable="ac&#305;2"/>
            <output expression="&quot;3. A&#231;&#305; De&#287;erini Giriniz: &quot;" newline="True"/>
            <input variable="ac&#305;3"/>
            <assign variable="ac&#305;toplam" expression="ac&#305;1 + ac&#305;2 + ac&#305;3"/>
            <if expression="ac&#305;toplam == 180 and ac&#305;1 &gt; 0 and ac&#305;2 &gt; 0 and ac&#305;3 &gt; 0">
                <then>
                    <output expression="&quot;A&#231;&#305;lar&#305; &quot;&amp;ac&#305;1&amp;&quot;, &quot;&amp;ac&#305;2&amp;&quot;, &quot;&amp;ac&#305;3&amp;&quot; olan bir &#252;&#231;gen olu&#351;turulabilir.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;!!B&#246;yle bir &#252;&#231;gen olu&#351;turulamaz.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
