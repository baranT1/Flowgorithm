<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Flow %10 alma &#246;devi"/>
        <attribute name="authors" value="baran"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-12 11:52:36 &#214;S"/>
        <attribute name="created" value="YmFyYW47RVpHSTsyMDI2LTEwLTEyOzExOjQxOjA1IMOWUzsyMjI5"/>
        <attribute name="edited" value="YmFyYW47RVpHSTsyMDI2LTEwLTEyOzExOjUyOjM2IMOWUzsxOzIzNDM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="&#252;r&#252;n1, &#252;r&#252;n2, toplamtutar, indirimlitutar1, indirimlitutar2" type="Real" array="False" size=""/>
            <output expression="&quot;1. &#252;r&#252;n fiyat&#305;: &quot;" newline="True"/>
            <input variable="&#252;r&#252;n1"/>
            <output expression="&quot;2. &#252;r&#252;n fiyat&#305;: &quot;" newline="True"/>
            <input variable="&#252;r&#252;n2"/>
            <assign variable="toplamtutar" expression="&#252;r&#252;n1 + &#252;r&#252;n2"/>
            <if expression="toplamtutar &lt;= 5000">
                <then>
                    <output expression="&quot;Toplam tutar: &quot;&amp;toplamtutar&amp;&quot; TL&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="&#252;r&#252;n1 &gt;= &#252;r&#252;n2">
                        <then>
                            <assign variable="indirimlitutar1" expression="(&#252;r&#252;n1 * 0.9) + &#252;r&#252;n2"/>
                            <output expression="&quot;Toplam Tutar: &quot;&amp;indirimlitutar1&amp;&quot; TL&quot;" newline="True"/>
                        </then>
                        <else>
                            <assign variable="indirimlitutar2" expression="(&#252;r&#252;n2 * 0.9) + &#252;r&#252;n1"/>
                            <output expression="&quot;Toplam tutar: &quot;&amp;indirimlitutar2&amp;&quot; TL&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
