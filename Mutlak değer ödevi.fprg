    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x, mutlakde&#287;er" type="Real" array="False" size=""/>
            <output expression="&quot;Bir say&#305; giriniz&quot;" newline="True"/>
            <input variable="x"/>
